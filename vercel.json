{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "redirects":[
    {"source":"/admin","destination":"/admin/gbpcheck/","permanent":false},
    {"source":"/admin/","destination":"/admin/gbpcheck/","permanent":false}
  ],
  "rewrites":[
    {"source":"/admin/gbpcheck","destination":"https://gbpcheck-bnc.vercel.app/admin/gbpcheck/"},
    {"source":"/admin/gbpcheck/:path(.*)","destination":"https://gbpcheck-bnc.vercel.app/admin/gbpcheck/:path"}
  ],
  "headers":[{"source":"/admin/:path*","headers":[
    {"key":"Cache-Control","value":"private, no-store, max-age=0"},
    {"key":"CDN-Cache-Control","value":"no-store"},
    {"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"}
  ]}]
}
